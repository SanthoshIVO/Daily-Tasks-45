{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "pdf-rag-intro",
   "metadata": {},
   "source": "# PDF Analyzer: RAG and Retrieval Evaluation\n\nThis notebook combines PDF loading, chunking, vector search, retrieval testing, and optional answer generation in one workflow. It is designed to work with any text-based PDF. Scanned/image-only PDFs need OCR before loading.\n\nRun the setup and indexing cells first. Retrieval and evaluation do not need an LLM API key. Edit the ground-truth chunk IDs after reviewing the chunk table before interpreting evaluation metrics."
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-dependencies",
   "metadata": {},
   "outputs": [],
   "source": "# If needed, install dependencies in this notebook's environment:\n# %pip install langchain-community langchain-text-splitters langchain-huggingface langchain-google-genai sentence-transformers faiss-cpu pypdf"
  },
  {
   "cell_type": "markdown",
   "id": "pdf-rag-imports-heading",
   "metadata": {},
   "source": "## 1. Imports and PDF selection"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-imports",
   "metadata": {},
   "outputs": [],
   "source": "import os\nimport re\nfrom pathlib import Path\nfrom typing import Iterable\n\nfrom IPython.display import display\nfrom langchain_community.document_loaders import PyPDFLoader\nfrom langchain_community.vectorstores import FAISS\nfrom langchain_core.documents import Document\nfrom langchain_core.output_parsers import StrOutputParser\nfrom langchain_core.prompts import ChatPromptTemplate\nfrom langchain_huggingface import HuggingFaceEmbeddings\nfrom langchain_text_splitters import RecursiveCharacterTextSplitter\n\nPDF_PATH = Path(\"Santhosh_S_S_AIML_resume.pdf\")\n\nif not PDF_PATH.is_absolute() and not PDF_PATH.is_file():\n    workspace_path = Path.cwd() / \"WEEK2\" / \"DAY9\" / \"RAG\" / PDF_PATH\n    if workspace_path.is_file():\n        PDF_PATH = workspace_path\n\nif not PDF_PATH.is_file():\n    raise FileNotFoundError(\n        f\"PDF not found: {PDF_PATH.resolve()}. Set PDF_PATH to the PDF you want to analyze.\"\n    )"
  },
  {
   "cell_type": "markdown",
   "id": "pdf-rag-load-heading",
   "metadata": {},
   "source": "## 2. Load all PDF pages and preserve page metadata"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-load",
   "metadata": {},
   "outputs": [],
   "source": "pdf_pages = PyPDFLoader(str(PDF_PATH)).load()\nif not pdf_pages:\n    raise ValueError(f\"No pages were loaded from {PDF_PATH}.\")\n\nsource_path = str(PDF_PATH.resolve())\npage_documents = []\nfor page in pdf_pages:\n    page_text = re.sub(r\"\\s+\", \" \", page.page_content).strip()\n    if page_text:\n        metadata = {**page.metadata, \"source\": source_path}\n        page_documents.append(Document(page_content=page_text, metadata=metadata))\n\nif not page_documents:\n    raise ValueError(\n        \"No extractable text was found in the PDF. If it is scanned, run OCR first.\"\n    )\n\nprint(f\"Loaded {len(pdf_pages)} PDF pages; {len(page_documents)} contain text.\")\ndisplay(\n    [\n        {\n            \"page\": int(doc.metadata.get(\"page\", i)) + 1,\n            \"characters\": len(doc.page_content),\n            \"preview\": doc.page_content[:180],\n        }\n        for i, doc in enumerate(page_documents)\n    ]\n)"
  },
  {
   "cell_type": "markdown",
   "id": "pdf-rag-chunk-heading",
   "metadata": {},
   "source": "## 3. Split into chunks and remove exact duplicates\n\nOnly whitespace is normalized. Keep original words, punctuation, and stop words for stronger semantic retrieval. Duplicate chunks retain the page numbers where they appeared."
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-chunk",
   "metadata": {},
   "outputs": [],
   "source": "splitter = RecursiveCharacterTextSplitter(\n    chunk_size=700,\n    chunk_overlap=100,\n    add_start_index=True,\n)\nsplit_documents = splitter.split_documents(page_documents)\n\nunique_by_text = {}\nfor document in split_documents:\n    key = re.sub(r\"\\s+\", \" \", document.page_content).strip().casefold()\n    if not key:\n        continue\n\n    page = document.metadata.get(\"page\")\n    if key not in unique_by_text:\n        metadata = {**document.metadata, \"pages\": []}\n        if page is not None:\n            metadata[\"pages\"].append(int(page))\n        unique_by_text[key] = Document(\n            page_content=document.page_content,\n            metadata=metadata,\n        )\n    elif page is not None:\n        pages = unique_by_text[key].metadata[\"pages\"]\n        if int(page) not in pages:\n            pages.append(int(page))\n\nchunks = list(unique_by_text.values())\nfor chunk_number, document in enumerate(chunks):\n    document.metadata[\"chunk_id\"] = f\"chunk-{chunk_number:04d}\"\n\nif not chunks:\n    raise ValueError(\"No non-empty chunks were created from the PDF.\")\n\nprint(f\"Created {len(split_documents)} chunks; {len(chunks)} remain after deduplication.\")"
  },
  {
   "cell_type": "markdown",
   "id": "pdf-rag-review-heading",
   "metadata": {},
   "source": "## 4. Review chunk IDs before retrieval evaluation"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-review",
   "metadata": {},
   "outputs": [],
   "source": "chunk_table = [\n    {\n        \"chunk_id\": document.metadata[\"chunk_id\"],\n        \"pages\": [page + 1 for page in document.metadata.get(\"pages\", [])],\n        \"characters\": len(document.page_content),\n        \"text\": document.page_content,\n    }\n    for document in chunks\n]\ndisplay(chunk_table)"
  },
  {
   "cell_type": "markdown",
   "id": "pdf-rag-index-heading",
   "metadata": {},
   "source": "## 5. Embed chunks and build the FAISS index"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-index",
   "metadata": {},
   "outputs": [],
   "source": "embedding_model = HuggingFaceEmbeddings(\n    model_name=\"sentence-transformers/all-MiniLM-L6-v2\",\n)\nvector_store = FAISS.from_documents(\n    documents=chunks,\n    embedding=embedding_model,\n)\nprint(f\"FAISS index ready with {len(chunks)} chunks.\")"
  },
  {
   "cell_type": "markdown",
   "id": "pdf-rag-retrieval-heading",
   "metadata": {},
   "source": "## 6. Retrieve relevant chunks"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-retrieval",
   "metadata": {},
   "outputs": [],
   "source": "def retrieve(query: str, k: int = 4) -> list[Document]:\n    if not query or not query.strip():\n        raise ValueError(\"The retrieval query must not be empty.\")\n    if k <= 0:\n        raise ValueError(\"k must be a positive integer.\")\n    return vector_store.similarity_search(query.strip(), k=min(k, len(chunks)))\n\n\ndef retrieved_chunk_ids(documents: Iterable[Document]) -> list[str]:\n    return [document.metadata[\"chunk_id\"] for document in documents]\n\ndemo_query = \"Summarize the document's key information.\"\ndemo_results = retrieve(demo_query, k=4)\nprint(f\"Query: {demo_query}\")\nfor rank, document in enumerate(demo_results, start=1):\n    page_numbers = [page + 1 for page in document.metadata.get(\"pages\", [])]\n    print(\n        f\"\\n{rank}. {document.metadata['chunk_id']} \"\n        f\"(page(s): {page_numbers or 'unknown'})\"\n    )\n    print(document.page_content)"
  },
  {
   "cell_type": "markdown",
   "id": "pdf-rag-metrics-heading",
   "metadata": {},
   "source": "## 7. Retrieval metrics: Recall@k, Precision@k, and MRR"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-metrics",
   "metadata": {},
   "outputs": [],
   "source": "def recall_at_k(retrieved: list[str], relevant: list[str], k: int) -> float | None:\n    if k <= 0:\n        raise ValueError(\"k must be a positive integer.\")\n    relevant_ids = set(relevant)\n    if not relevant_ids:\n        return None\n    return len(set(retrieved[:k]) & relevant_ids) / len(relevant_ids)\n\n\ndef precision_at_k(retrieved: list[str], relevant: list[str], k: int) -> float:\n    if k <= 0:\n        raise ValueError(\"k must be a positive integer.\")\n    top_k = retrieved[:k]\n    if not top_k:\n        return 0.0\n    return len(set(top_k) & set(relevant)) / len(top_k)\n\n\ndef reciprocal_rank(retrieved: list[str], relevant: list[str]) -> float:\n    relevant_ids = set(relevant)\n    if not relevant_ids:\n        return 0.0\n    for rank, chunk_id in enumerate(retrieved, start=1):\n        if chunk_id in relevant_ids:\n            return 1.0 / rank\n    return 0.0"
  },
  {
   "cell_type": "markdown",
   "id": "pdf-rag-evaluation-heading",
   "metadata": {},
   "source": "## 8. Curate ground truth and evaluate retrieval\n\nFor each query, use the chunk table above to identify all chunks that truly answer it, then enter their chunk_id values below. Empty lists are intentionally not treated as ground truth. Keyword overlap alone is not proof that a chunk is relevant."
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-evaluation",
   "metadata": {},
   "outputs": [],
   "source": "evaluation_queries = [\n    \"What is the document about?\",\n    \"What are the most important qualifications or findings?\",\n]\n\n# Replace [] with the manually reviewed chunk IDs relevant to each query.\nground_truth = {\n    \"What is the document about?\": [],\n    \"What are the most important qualifications or findings?\": [],\n}\n\nK = 4\nif K <= 0:\n    raise ValueError(\"K must be a positive integer.\")\n\nevaluation_rows = []\nfor query in evaluation_queries:\n    relevant_ids = ground_truth.get(query, [])\n    if not relevant_ids:\n        print(f\"Skipping '{query}': curate its ground_truth chunk IDs first.\")\n        continue\n\n    found_ids = retrieved_chunk_ids(retrieve(query, k=K))\n    effective_k = min(K, len(chunks))\n    row = {\n        \"query\": query,\n        \"relevant_chunk_ids\": relevant_ids,\n        \"retrieved_chunk_ids\": found_ids,\n        \"recall_at_k\": recall_at_k(found_ids, relevant_ids, effective_k),\n        \"precision_at_k\": precision_at_k(found_ids, relevant_ids, effective_k),\n        \"reciprocal_rank\": reciprocal_rank(found_ids, relevant_ids),\n    }\n    evaluation_rows.append(row)\n\nif evaluation_rows:\n    display(evaluation_rows)\n    mean_recall = sum(row[\"recall_at_k\"] for row in evaluation_rows) / len(evaluation_rows)\n    mean_precision = sum(row[\"precision_at_k\"] for row in evaluation_rows) / len(evaluation_rows)\n    mean_reciprocal_rank = (\n        sum(row[\"reciprocal_rank\"] for row in evaluation_rows) / len(evaluation_rows)\n    )\n    print(f\"Evaluated queries: {len(evaluation_rows)}\")\n    print(f\"Mean Recall@{K}: {mean_recall:.3f}\")\n    print(f\"Mean Precision@{K}: {mean_precision:.3f}\")\n    print(f\"Mean Reciprocal Rank: {mean_reciprocal_rank:.3f}\")\nelse:\n    print(\"No evaluation metrics yet. Add reviewed chunk IDs to ground_truth and rerun.\")"
  },
  {
   "cell_type": "markdown",
   "id": "pdf-rag-generation-heading",
   "metadata": {},
   "source": "## 9. Optional Gemini answer generation (not called automatically)"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pdf-rag-generation",
   "metadata": {},
   "outputs": [],
   "source": "def answer_question(query: str, k: int = 4) -> str:\n    api_key = os.getenv(\"GOOGLE_API_KEY\") or os.getenv(\"GeminiAPIKey\")\n    if not api_key:\n        raise RuntimeError(\n            \"Set GOOGLE_API_KEY or GeminiAPIKey in the environment before generation.\"\n        )\n\n    documents = retrieve(query, k=k)\n    if not documents:\n        raise ValueError(\"No chunks were retrieved; unable to answer this question.\")\n\n    context_parts = []\n    for document in documents:\n        pages = [page + 1 for page in document.metadata.get(\"pages\", [])]\n        page_label = \", \\".join(str(page) for page in pages) if pages else \"unknown\"\n        context_parts.append(\n            f\"[{document.metadata['chunk_id']}; page(s) {page_label}]\\n\"\n            f\"{document.page_content}\"\n        )\n    context = \\"\\n\\n\\